+            ->orderBy('name')
+            ->get([
+                'id',
+                'name',
+                'title',
+                'city_title',
+                'subcity_title',
+                'woreda_title',
+                'administrative_level',
+                'city_id',
+                'subcity_id',
+                'woreda_id',
+                'availability',
+            ]);
+
+        return response()->json([
+            'success' => true,
+            'message' => 'Windows retrieved successfully',
+            'data' => $windows,
+        ]);
